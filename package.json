{
  "name": "assistente-loja",
  "version": "1.0.0",
  "description": "API que responde perguntas sobre as políticas da loja usando RAG e Gemini",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "index": "tsx --env-file=.env src/build-index.ts",
    "dev": "tsx --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm --prefix web ci && npm run web:build && npm run ingest && tsx src/build-index.ts",
    "eval": "tsx --env-file=.env src/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@google/genai": "^2.32.0",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
